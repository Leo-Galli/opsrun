---
import BaseLayout from '../layouts/BaseLayout.astro'
import { runbooks, runbooksPath, githubRepo } from '../data/runbooks'
---

<BaseLayout
  title="Runbooks"
  description="Nine production-shaped OpsRun incident runbooks."
  path="/runbooks"
>
  <p class="label">Examples</p>
  <h1 class="mt-2 text-2xl font-semibold tracking-tight text-fg">Runbooks</h1>
  <p class="mt-3 max-w-[36rem] text-[15px] leading-6 text-fg-3">
    Files in
    <a class="underline decoration-rule underline-offset-2" href={runbooksPath} rel="noopener noreferrer" target="_blank">
      examples/runbooks/
    </a>
    . Validate and plan without SSH.
  </p>

  <ul class="mt-8 divide-y divide-rule border-y border-rule">
    {
      runbooks.map((rb) => (
        <li class="py-4">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <a
              class="font-mono text-[13px] text-fg hover:underline"
              href={`${githubRepo}/blob/main/examples/runbooks/${rb.file}`}
              rel="noopener noreferrer"
              target="_blank"
            >
              {rb.file}
            </a>
            <span class="text-[12px] text-fg-3">{rb.severity} · {rb.service}</span>
          </div>
          <p class="mt-1 text-[14px] leading-6 text-fg-2">{rb.summary}</p>
          <p class="mt-2 break-words font-mono text-[12px] leading-5 text-fg-3">{rb.try}</p>
        </li>
      ))
    }
  </ul>

  <pre class="code mt-8"><code>opsrun validate examples/runbooks/full-disk.md
opsrun plan examples/runbooks/rolling-deploy.md --var release_tag=v1.4.2</code></pre>

  <p class="mt-4 text-[13px]">
    <a class="underline decoration-rule underline-offset-4" href="/docs/examples">Examples guide</a>
  </p>
</BaseLayout>
