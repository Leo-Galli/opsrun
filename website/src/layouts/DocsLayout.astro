---
import BaseLayout from './BaseLayout.astro'
import { docsNav } from '../data/docs'

type Props = {
  title: string
  description: string
  path: string
}

const { title, description, path } = Astro.props
const normalized = path.replace(/\/$/, '') || '/docs'
const index = docsNav.findIndex((item) => item.href === normalized)
const prev = index > 0 ? docsNav[index - 1] : null
const next = index >= 0 && index < docsNav.length - 1 ? docsNav[index + 1] : null
---

<BaseLayout title={title} description={description} path={path}>
  <div class="grid gap-10 lg:grid-cols-[180px_minmax(0,1fr)] lg:gap-12">
    <aside aria-label="Documentation">
      <p class="label mb-3">Docs</p>
      <nav class="flex flex-wrap gap-x-4 gap-y-1 text-[13px] lg:flex-col lg:gap-1">
        {
          docsNav.map((item) => {
            const active = normalized === item.href
            return (
              <a
                href={item.href}
                class:list={[active ? 'font-medium text-fg' : 'text-fg-3 hover:text-fg']}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
              </a>
            )
          })
        }
      </nav>
    </aside>

    <div class="min-w-0">
      <header class="mb-8 border-b border-rule pb-5">
        <p class="label">Documentation</p>
        <h1 class="mt-2 text-2xl font-semibold tracking-tight text-fg sm:text-[1.75rem]">
          {title}
        </h1>
        <p class="mt-2 max-w-[42rem] text-[15px] leading-6 text-fg-3">{description}</p>
      </header>

      <article class="prose-docs">
        <slot />
      </article>

      <nav class="mt-12 flex justify-between gap-4 border-t border-rule pt-5 text-[13px]" aria-label="Docs pagination">
        {prev ? <a href={prev.href} class="text-fg-3 hover:text-fg">← {prev.label}</a> : <span />}
        {next ? <a href={next.href} class="text-fg-3 hover:text-fg">{next.label} →</a> : null}
      </nav>
    </div>
  </div>
</BaseLayout>
